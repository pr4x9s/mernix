    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.10",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "2.11.0",
