{
  "name": "server",
  "module": "./src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --watch ./src/server.ts",
    "start": "tsx ./src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "type-watch": "tsc --noEmit -w",
